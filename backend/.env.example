# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Overleaf Session Cookie
# How to get:
#   1. Log into https://www.overleaf.com
#   2. Open DevTools → Application → Cookies → https://www.overleaf.com
#   3. Copy the VALUE of the "overleaf_session2" cookie (URL-encoded string)
OVERLEAF_SESSION_COOKIE=s%3A...

# Overleaf GCLB Cookie
# Same steps as above — copy the VALUE of the "GCLB" cookie
OVERLEAF_GCLB_TOKEN=...

# Frontend URL (for CORS) - update in production
FRONTEND_URL=http://localhost:3000

# Port for the backend server
PORT=3001
